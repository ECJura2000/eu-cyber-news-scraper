{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ECJura2000/eu-cyber-news-scraper/schemas/run-v5.schema.json",
  "title": "EU cyber news run manifest v5",
  "type": "object",
  "required": ["schema_version", "run_id", "period", "article_count", "artifact_bundle_complete", "artifact_manifest", "sources"],
  "properties": {
    "schema_version": {"const": 5},
    "run_id": {"type": "string", "minLength": 1},
    "period": {"type": "object"},
    "article_count": {"type": "integer", "minimum": 0},
    "artifact_bundle_complete": {"const": true},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "artifact_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "relative_path", "sha256", "size_bytes", "row_count", "complete"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "row_count": {"type": "integer", "minimum": 0},
          "complete": {"const": true}
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "required": ["passed", "failures"]
    },
    "sources": {"type": "array"}
  },
  "additionalProperties": true
}
